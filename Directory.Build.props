<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment; enforced by review for public API, not by the compiler. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>0.1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>zab1yak</Authors>
    <Product>Dynamic Island for Windows</Product>
    <Copyright>Copyright (c) 2026 zab1yak</Copyright>
    <RepositoryUrl>https://github.com/zab1yak/dynamic-island-windows</RepositoryUrl>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>

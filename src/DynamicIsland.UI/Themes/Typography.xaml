<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Official Inter 4.1 static faces; explicit pack URI avoids machine font substitution. -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/DynamicIsland.UI;component/Fonts/Inter/#Inter</FontFamily>
    <FontFamily x:Key="Font.Text">pack://application:,,,/DynamicIsland.UI;component/Fonts/Inter/#Inter</FontFamily>

    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">12</sys:Double>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Button">12</sys:Double>
    <sys:Double x:Key="FontSize.Control">13</sys:Double>
    <sys:Double x:Key="FontSize.Editor">14</sys:Double>
    <sys:Double x:Key="FontSize.Compact">13</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">15</sys:Double>
    <sys:Double x:Key="FontSize.SettingsTitle">20</sys:Double>
    <sys:Double x:Key="FontSize.MediumNumber">22</sys:Double>
    <sys:Double x:Key="FontSize.Timer">40</sys:Double>
    <sys:Double x:Key="FontSize.Tooltip">12</sys:Double>

    <FontWeight x:Key="FontWeight.Regular">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>

    <sys:Double x:Key="LineHeight.Body">18</sys:Double>
    <sys:Double x:Key="LineHeight.Secondary">16</sys:Double>
    <sys:Double x:Key="LineHeight.Caption">15</sys:Double>
    <sys:Double x:Key="LineHeight.Button">16</sys:Double>
    <sys:Double x:Key="LineHeight.Control">18</sys:Double>
    <sys:Double x:Key="LineHeight.Editor">20</sys:Double>
    <sys:Double x:Key="LineHeight.Compact">18</sys:Double>
    <sys:Double x:Key="LineHeight.PageTitle">20</sys:Double>
    <sys:Double x:Key="LineHeight.SettingsTitle">26</sys:Double>
    <sys:Double x:Key="LineHeight.MediumNumber">28</sys:Double>
    <sys:Double x:Key="LineHeight.Timer">48</sys:Double>
    <sys:Double x:Key="LineHeight.Tooltip">16</sys:Double>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Regular}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <!-- Tabular figures: digits keep their width, timers never jitter. -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Island.CompactTime" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Compact}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Compact}" />
    </Style>

    <Style x:Key="Island.HeaderPrimary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}" />
    </Style>

    <!-- Page title in the island header ("Pomodoro", "Water Reminder"). -->
    <Style x:Key="Island.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Bold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.PageTitle}" />
    </Style>

    <Style x:Key="Island.HeaderSecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.PageTitle}" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Secondary}" />
    </Style>

    <!-- Medium figures ("0.3 / 2.0 L" on the water page). -->
    <Style x:Key="Text.MediumNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Bold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.MediumNumber}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.MediumNumber}" />
    </Style>

    <Style x:Key="Text.LargeNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Timer}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Timer}" />
    </Style>

    <Style x:Key="Settings.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>

    <Style x:Key="Settings.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="Margin" Value="4,0,0,6" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}" />
    </Style>
    <!-- Popups do not inherit an owner window's font or dark-theme foreground. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Tooltip}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.PopupSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Island.Stroke}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls"
                    xmlns:a="clr-namespace:DynamicIsland.UI.Animation"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:cv="clr-namespace:DynamicIsland.UI.Converters">

    <cv:BytesToImageConverter x:Key="BytesToImage" />
    <cv:ArgbToBrushConverter x:Key="ArgbToBrush" />
    <cv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <cv:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!-- Radii (continuous corners everywhere). -->
    <sys:Double x:Key="Radius.Small">8</sys:Double>
    <sys:Double x:Key="Radius.Medium">12</sys:Double>
    <sys:Double x:Key="Radius.Large">18</sys:Double>
    <sys:Double x:Key="Radius.Pill">999</sys:Double>

    <!-- Spacing. -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>

    <!-- Shadows. -->
    <DropShadowEffect x:Key="Shadow.Soft" Color="Black" Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.35" RenderingBias="Performance" />

    <a:SpringEase x:Key="Ease.Spring" DampingRatio="0.7" />
    <a:SpringEase x:Key="Ease.SpringSoft" DampingRatio="0.9" />

    <!-- Hover: the background brightens softly instead of snapping. -->
    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="c:Press.Scale" Value="0.92" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <c:SquircleBorder x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=999}" />
                        <c:SquircleBorder x:Name="Hover" Background="{DynamicResource Brush.Hover}" Opacity="0" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=999}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (prev/next, arrows, close). Content: an Icon. -->
    <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- Capsule button with text ("Short Break", "Add Task"). -->
    <Style x:Key="PillButton" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Large circular primary action (play in Pomodoro). -->
    <Style x:Key="PrimaryButton.Red" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

    <Style x:Key="PrimaryButton.Blue" TargetType="ButtonBase" BasedOn="{StaticResource PrimaryButton.Red}">
        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
    </Style>

    <!-- Capsule progress bar. -->
    <Style x:Key="ProgressBar.Pill" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <c:SquircleBorder Background="{TemplateBinding Background}" CornerRadius="999">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <c:SquircleBorder x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="999" />
                        </Grid>
                    </c:SquircleBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS toggle switch. -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <c:SquircleBorder x:Name="Track" Background="{DynamicResource Brush.Surface3}" CornerRadius="999" />
                        <c:SquircleBorder x:Name="TrackOn" Background="{DynamicResource Brush.Green}" CornerRadius="999" Opacity="0" />
                        <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"
                                 Effect="{StaticResource Shadow.Soft}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbOffset" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.35" EasingFunction="{StaticResource Ease.Spring}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Ease.Spring}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field. -->
    <Style x:Key="TextField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <c:SquircleBorder x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                          BorderBrush="{DynamicResource Island.Stroke}" BorderThickness="1" />
                        <c:SquircleBorder x:Name="Focus" CornerRadius="10" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1.5" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" Visibility="Collapsed"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:PageDots">
        <Setter Property="ActiveBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="InactiveBrush" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="Height" Value="6" />
    </Style>

    <Style TargetType="c:RingProgress">
        <Setter Property="TrackBrush" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <c:ValueWithSuffixConverter x:Key="ValueWithSuffix" />

    <Style TargetType="c:NumberStepper">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NumberStepper">
                    <c:SquircleBorder Background="{DynamicResource Brush.Surface2}" CornerRadius="999" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Command="{x:Static c:NumberStepper.Decrease}">
                                <c:Icon Glyph="Minus" Width="12" Height="12" />
                            </Button>
                            <TextBlock MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource Text.Base}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ValueWithSuffix}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Suffix" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Command="{x:Static c:NumberStepper.Increase}">
                                <c:Icon Glyph="Plus" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </c:SquircleBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark capsule ComboBox. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <c:SquircleBorder Background="{DynamicResource Brush.Surface2}" CornerRadius="8" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <c:Icon Glyph="ChevronRight" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5"
                                Foreground="{DynamicResource Brush.TextSecondary}">
                            <c:Icon.RenderTransform><RotateTransform Angle="90" /></c:Icon.RenderTransform>
                        </c:Icon>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <c:SquircleBorder Background="{DynamicResource Brush.Surface2}" CornerRadius="10" BorderBrush="{DynamicResource Island.Stroke}" BorderThickness="1"
                                              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </c:SquircleBorder>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Grid>
                                    <c:SquircleBorder x:Name="Bg" CornerRadius="6" />
                                    <ContentPresenter Margin="10,6" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings window building blocks (macOS System Settings look). -->
    <Style x:Key="Settings.Group" TargetType="c:SquircleBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Island.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="Settings.Row" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="LastChildFill" Value="False" />
    </Style>

    <Style x:Key="Settings.Separator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource Island.Stroke}" />
    </Style>
</ResourceDictionary>

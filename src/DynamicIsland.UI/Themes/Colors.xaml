<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- iOS dark palette. Every colour used in the app comes from here. -->
    <Color x:Key="Color.Island">#FF000000</Color>
    <Color x:Key="Color.Surface1">#FF1C1C1E</Color>
    <Color x:Key="Color.Surface2">#FF2C2C2E</Color>
    <Color x:Key="Color.Surface3">#FF3A3A3C</Color>
    <Color x:Key="Color.TextPrimary">#FFFFFFFF</Color>
    <!-- rgba(235,235,245,0.6) -->
    <Color x:Key="Color.TextSecondary">#99EBEBF5</Color>
    <!-- rgba(235,235,245,0.3) -->
    <Color x:Key="Color.TextTertiary">#4DEBEBF5</Color>
    <!-- rgba(255,255,255,0.06) -->
    <Color x:Key="Color.Stroke">#0FFFFFFF</Color>
    <Color x:Key="Color.Hover">#14FFFFFF</Color>
    <Color x:Key="Color.Pressed">#24FFFFFF</Color>
    <Color x:Key="Color.Green">#FF30D158</Color>
    <Color x:Key="Color.Red">#FFFF453A</Color>
    <Color x:Key="Color.Orange">#FFFF9F0A</Color>
    <Color x:Key="Color.Yellow">#FFFFD60A</Color>
    <Color x:Key="Color.Blue">#FF0A84FF</Color>

    <SolidColorBrush x:Key="Island.Background" Color="{StaticResource Color.Island}" />
    <SolidColorBrush x:Key="Island.Stroke" Color="{StaticResource Color.Stroke}" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}" />
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}" />
    <SolidColorBrush x:Key="Brush.Yellow" Color="{StaticResource Color.Yellow}" />
    <SolidColorBrush x:Key="Brush.Blue" Color="{StaticResource Color.Blue}" />
</ResourceDictionary>

<Window x:Class="DynamicIsland.App.Island.IslandWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:island="clr-namespace:DynamicIsland.App.Island"
        xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
        xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance island:IslandViewModel}"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="Root" Background="{x:Null}">
        <!-- LayoutTransform, not RenderTransform: the scaled root must FIT the scaled window. A render
             transform keeps the unscaled layout size, WPF clips it to the window and then shrinks the clip
             too, cutting off the rounded corners and shoulders (v0.2.0 regression R1). -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- Hover zone: sized to the TARGET island, not the animating shape, so hover cannot flicker at the edge. -->
        <Rectangle x:Name="HoverZone" Fill="{DynamicResource Island.DropCatcher}" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Island body: pure black, top fused with the screen edge. -->
        <Path x:Name="Body" Fill="{x:Static island:IslandTheme.BodyBrush}">
            <Path.Effect>
                <DropShadowEffect x:Name="BodyShadow" Color="Black" Direction="270" ShadowDepth="3"
                                  BlurRadius="20" Opacity="0" RenderingBias="Performance" />
            </Path.Effect>
        </Path>

        <!-- Hairline inner stroke, visible only when expanded. -->
        <Path x:Name="Outline" Stroke="{DynamicResource Island.Stroke}" StrokeThickness="1" Opacity="0"
              IsHitTestVisible="False" />

        <Grid x:Name="ContentHost">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="Visible" />
                <!-- Sound wave (as on the reference photos): live bars while music plays, a static icon otherwise. -->
                <DataTemplate x:Key="SoundWave">
                    <Grid Width="18" Height="14" VerticalAlignment="Center">
                        <c:Icon Glyph="AudioLines" Width="16" Height="14" Foreground="{DynamicResource Brush.TextSecondary}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <c:VisualizerBars Levels="{Binding Levels}" BarBrush="{DynamicResource Brush.TextSecondary}"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}" />
                    </Grid>
                </DataTemplate>
                <!-- iOS-style privacy dots, most important first: screen sharing (red ring), camera (red), microphone (orange). -->
                <DataTemplate x:Key="PrivacyDots">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="11" Height="11" Margin="3,0,0,0" Visibility="{Binding Recording, Converter={StaticResource Visible}}">
                            <Ellipse Stroke="{DynamicResource Brush.Red}" StrokeThickness="1.5" />
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Red}" />
                        </Grid>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Red}" Margin="3,0,0,0"
                                 Visibility="{Binding CameraInUse, Converter={StaticResource Visible}}" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Orange}" Margin="3,0,0,0"
                                 Visibility="{Binding MicrophoneInUse, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DataTemplate>
            </Grid.Resources>

            <!-- Compact pill: battery left, time in the middle, privacy dots and the sound wave right. -->
            <Grid x:Name="CompactLayer" Width="200" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CompactScale" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:BatteryIndicator Grid.Column="0" Status="{Binding Status.BatteryStatus}" Height="16"
                                    HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Time24}" Style="{DynamicResource Island.CompactTime}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource PrivacyDots}" Margin="0,0,6,0" />
                    <ContentPresenter Content="{Binding Playback}" ContentTemplate="{StaticResource SoundWave}"
                                      Visibility="{Binding Playback, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- Live activity pill: the winning activity, then a hint of the runner-up and privacy dots. -->
            <Grid x:Name="LiveLayer" Width="300" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LiveScale" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding Live.Primary}" Margin="12,0,8,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <c:Icon Glyph="{Binding Live.SecondaryIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.TextSecondary}"
                            Margin="0,0,4,0" />
                    <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource PrivacyDots}" />
                </StackPanel>
            </Grid>

            <!-- Expanded card. -->
            <Grid x:Name="ExpandedLayer" Width="580" Height="160" HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <!-- Page title in one line, the last word coloured as on the reference photos («Water Reminder»). -->
                        <TextBlock x:Name="PageTitle" Style="{DynamicResource Island.PageTitle}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Modules.CurrentShowsTitle, Converter={StaticResource Visible}}">
                            <Run Text="{Binding Modules.CurrentTitleMain, Mode=OneWay}" /><Run Text="{Binding Modules.CurrentTitleAccent, Mode=OneWay}"
                                 Foreground="{Binding Modules.CurrentTitleAccentBrush, Mode=OneWay}" />
                        </TextBlock>
                        <!-- Music page: no title; the active browser tab instead (only when a browser is in front). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding Modules.CurrentShowsTitle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Status.BrowserTitle, Converter={StaticResource NullToVisibility}}">
                                <c:Icon Glyph="Globe" Width="11" Height="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,5,0" />
                                <c:MarqueeText Text="{Binding Status.BrowserTitle}" TextStyle="{DynamicResource Text.Secondary}" Width="140"
                                               ToolTip="{Binding Status.BrowserTitle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <c:BatteryIndicator Status="{Binding Status.BatteryStatus}" Height="16" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Status.BatteryText}" Style="{DynamicResource Island.HeaderSecondary}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DateText}" Style="{DynamicResource Island.HeaderSecondary}" />
                        <TextBlock Text="{Binding Time24}" Style="{DynamicResource Island.HeaderPrimary}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource PrivacyDots}" />
                        <TextBlock Text="{Binding Status.PrivacyText}" Style="{DynamicResource Text.Secondary}" FontSize="11"
                                   MaxWidth="130" Margin="6,0,0,0" ToolTip="{Binding Status.PrivacyText}" />
                        <ContentPresenter Content="{Binding Playback}" ContentTemplate="{StaticResource SoundWave}" Margin="8,0,0,0"
                                          Visibility="{Binding Playback, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Grid>
                <ContentPresenter x:Name="PageHost" Grid.Row="1" Margin="48,0,48,0" Content="{Binding Modules.CurrentPage}"
                                  RenderTransformOrigin="0.5,0.5">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="PageOffset" />
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
                <Button Grid.Row="1" Style="{DynamicResource PageArrow}" HorizontalAlignment="Left" Margin="12,0,0,0"
                        Command="{Binding Modules.PreviousPageCommand}" AutomationProperties.Name="{loc:Tr Island.PreviousPage}"
                        Visibility="{Binding HasSeveralPages, Converter={StaticResource Visible}}">
                    <c:Icon Glyph="ChevronLeft" Width="12" Height="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                </Button>
                <Button Grid.Row="1" Style="{DynamicResource PageArrow}" HorizontalAlignment="Right" Margin="0,0,12,0"
                        Command="{Binding Modules.NextPageCommand}" AutomationProperties.Name="{loc:Tr Island.NextPage}"
                        Visibility="{Binding HasSeveralPages, Converter={StaticResource Visible}}">
                    <c:Icon Glyph="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                </Button>
                <c:PageDots Grid.Row="2" Count="{Binding Modules.Pages.Count}" SelectedIndex="{Binding Modules.CurrentIndex}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Grid>
</Window>

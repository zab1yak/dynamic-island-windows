<Window x:Class="DynamicIsland.App.Island.IslandWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:island="clr-namespace:DynamicIsland.App.Island"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance island:IslandViewModel}"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0" Background="{x:Null}">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Island body: pure black, top fused with the screen edge. -->
        <Path x:Name="Body" Fill="{DynamicResource Island.Background}">
            <Path.Effect>
                <DropShadowEffect x:Name="BodyShadow" Color="Black" Direction="270" ShadowDepth="3"
                                  BlurRadius="20" Opacity="0" RenderingBias="Performance" />
            </Path.Effect>
        </Path>

        <!-- Hairline inner stroke, visible only when expanded. -->
        <Path x:Name="Outline" Stroke="{DynamicResource Island.Stroke}" StrokeThickness="1" Opacity="0"
              IsHitTestVisible="False" />

        <Grid x:Name="ContentHost">
            <!-- Compact pill: time in the middle, status left and right. -->
            <Grid x:Name="CompactLayer" Width="200" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CompactScale" />
                </Grid.RenderTransform>
                <TextBlock Text="{Binding Time24}" Style="{DynamicResource Island.CompactTime}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Expanded card. -->
            <Grid x:Name="ExpandedLayer" Width="580" Height="160" HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" Style="{DynamicResource Island.HeaderSecondary}" />
                    <TextBlock Text="{Binding Time24}" Style="{DynamicResource Island.HeaderPrimary}" Margin="8,0,0,0" />
                </StackPanel>
                <ContentPresenter x:Name="PageHost" Grid.Row="1" Margin="24,0,24,18" />
            </Grid>
        </Grid>
    </Grid>
</Window>

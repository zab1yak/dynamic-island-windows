<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:DynamicIsland.App.Island"
                    xmlns:s="clr-namespace:DynamicIsland.App.Settings"
                    xmlns:cs="clr-namespace:DynamicIsland.Core.Settings;assembly=DynamicIsland.Core"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
                    xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">

    <!-- Compact macOS-style groups for the island page (the settings window keeps its larger ones). -->
    <Style x:Key="Isl.Group" TargetType="c:SquircleBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Isl.Row" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="LastChildFill" Value="False" />
    </Style>
    <Style x:Key="Isl.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style x:Key="Isl.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,2,0,4" />
    </Style>
    <Style x:Key="Isl.Separator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource Island.Stroke}" />
    </Style>
    <!-- Segment of a segmented control: grey pill, blue when selected (Tag = True). -->
    <Style x:Key="Isl.Segment" TargetType="ButtonBase" BasedOn="{StaticResource PillButton}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <DataTemplate DataType="{x:Type i:IslandSettingsViewModel}">
        <!-- No visible scroll bar (macOS-like): the wheel and touchpad scroll; cut-off groups show there is more. -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,0,0,8">
            <StackPanel>

                <!-- Appearance and lock. -->
                <TextBlock Text="{loc:Tr Settings.Appearance}" Style="{StaticResource Isl.Header}" />
                <c:SquircleBorder Style="{StaticResource Isl.Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.Background}" Style="{StaticResource Isl.Label}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr Settings.BgTranslucent}" Command="{Binding SetBackgroundCommand}" CommandParameter="{x:Static cs:IslandBackground.Translucent}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Isl.Segment}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTranslucent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{loc:Tr Settings.BgBlack}" Command="{Binding SetBackgroundCommand}" CommandParameter="{x:Static cs:IslandBackground.Black}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Isl.Segment}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlack}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{loc:Tr Settings.BgLight}" Command="{Binding SetBackgroundCommand}" CommandParameter="{x:Static cs:IslandBackground.LightGray}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Isl.Segment}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightGray}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="330">
                                <TextBlock Text="{loc:Tr Settings.Lock}" Style="{StaticResource Isl.Label}" />
                                <TextBlock Style="{DynamicResource Text.Secondary}" FontSize="10" TextWrapping="Wrap">
                                    <Run Text="{loc:Tr Settings.LockHint}" /><Run Text=" " /><Run Text="{Binding General.Hotkey, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding IsLocked}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.Lock}" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>

                <!-- Pages: order and visibility; «Настройки» is always last. -->
                <TextBlock Text="{loc:Tr Settings.Modules}" Style="{StaticResource Isl.Header}" />
                <c:SquircleBorder Style="{StaticResource Isl.Group}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Pages.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type s:ModuleRow}">
                                    <DockPanel Style="{StaticResource Isl.Row}">
                                        <c:Icon Glyph="{Binding Icon}" Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Isl.Label}" />
                                        <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Title}" />
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,8,0"
                                                Command="{Binding DataContext.Pages.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{loc:Tr Settings.MoveDown}">
                                            <c:Icon Glyph="ChevronRight" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                                                <c:Icon.RenderTransform><RotateTransform Angle="90" /></c:Icon.RenderTransform>
                                            </c:Icon>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                Command="{Binding DataContext.Pages.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{loc:Tr Settings.MoveUp}">
                                            <c:Icon Glyph="ChevronLeft" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                                                <c:Icon.RenderTransform><RotateTransform Angle="90" /></c:Icon.RenderTransform>
                                            </c:Icon>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <c:Icon Glyph="Settings" Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr Settings.PageTitle}" Style="{StaticResource Isl.Label}" />
                            <TextBlock DockPanel.Dock="Right" Text="{loc:Tr Settings.AlwaysLast}" Style="{DynamicResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>

                <!-- General. -->
                <TextBlock Text="{loc:Tr Settings.General}" Style="{StaticResource Isl.Header}" />
                <c:SquircleBorder Style="{StaticResource Isl.Group}" DataContext="{Binding General}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.Autostart}" Style="{StaticResource Isl.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding LaunchAtStartup}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.Autostart}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.Language}" Style="{StaticResource Isl.Label}" />
                            <ListBox DockPanel.Dock="Right" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Background="Transparent"
                                     BorderThickness="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{loc:Tr Settings.Language}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Margin="4,0,0,0" Height="26">
                                                        <c:SquircleBorder x:Name="Bg" CornerRadius="999" Background="{DynamicResource Brush.Surface2}" />
                                                        <TextBlock x:Name="Label" Text="{Binding Label}" Style="{DynamicResource Text.Base}" FontSize="11" Margin="10,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.HideFullscreen}" Style="{StaticResource Isl.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.HideFullscreen}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.CheckUpdates}" Style="{StaticResource Isl.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.CheckUpdates}" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>

                <!-- Island behaviour. -->
                <TextBlock Text="{loc:Tr Settings.Island}" Style="{StaticResource Isl.Header}" />
                <c:SquircleBorder Style="{StaticResource Isl.Group}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Isl.Row}" DataContext="{Binding General}">
                            <TextBlock Text="{loc:Tr Settings.Size}" Style="{StaticResource Isl.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding IslandScalePercent}" Minimum="70" Maximum="130" Step="5" Suffix="%" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}" DataContext="{Binding General}">
                            <TextBlock Text="{loc:Tr Settings.ExpandDelay}" Style="{StaticResource Isl.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding ExpandDelayMs}" Minimum="0" Maximum="2000" Step="50" Suffix="{loc:Tr Settings.Ms}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}" DataContext="{Binding General}">
                            <TextBlock Text="{loc:Tr Settings.CollapseDelay}" Style="{StaticResource Isl.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding CollapseDelayMs}" Minimum="100" Maximum="5000" Step="50" Suffix="{loc:Tr Settings.Ms}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Isl.Separator}" />
                        <DockPanel Style="{StaticResource Isl.Row}">
                            <TextBlock Text="{loc:Tr Settings.Hotkey}" Style="{StaticResource Isl.Label}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Isl.Segment}" Content="{loc:Tr Settings.Change}" Command="{Binding ChangeHotkeyCommand}"
                                    VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr Settings.Hotkey}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding General.Hotkey}" Style="{DynamicResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>

                <!-- Every module's own settings (water, Pomodoro, shelf, recorder…), with their usual templates. -->
                <ItemsControl ItemsSource="{Binding ModuleGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type i:ModuleSettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Isl.Header}" />
                                <ContentPresenter Content="{Binding Content}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Quit with a two-step confirmation. -->
                <Button HorizontalAlignment="Stretch" Height="32" Margin="0,2,0,6" Command="{Binding QuitCommand}"
                        AutomationProperties.Name="{loc:Tr Settings.Quit}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Setter Property="Content" Value="{loc:Tr Settings.Quit}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QuitArmed}" Value="True">
                                    <Setter Property="Content" Value="{loc:Tr Settings.QuitConfirm}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>

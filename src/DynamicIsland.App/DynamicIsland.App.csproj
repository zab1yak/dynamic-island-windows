<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>DynamicIsland.App.Program</StartupObject>
    <!-- A small desktop app: one GC heap without the background GC thread, profile-guided JIT. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main builds the host before WPF starts, so App.xaml must not generate Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\island.ico" />
  </ItemGroup>

  <!-- The component gallery exists only in Debug builds. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Debug\ShowcaseWindow.xaml" />
    <Compile Remove="Debug\ShowcaseWindow.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Core\DynamicIsland.Core.csproj" />
    <ProjectReference Include="..\DynamicIsland.Platform.Windows\DynamicIsland.Platform.Windows.csproj" />
    <ProjectReference Include="..\DynamicIsland.UI\DynamicIsland.UI.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Media\DynamicIsland.Modules.Media.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Pomodoro\DynamicIsland.Modules.Pomodoro.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Water\DynamicIsland.Modules.Water.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Shelf\DynamicIsland.Modules.Shelf.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Todo\DynamicIsland.Modules.Todo.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Recorder\DynamicIsland.Modules.Recorder.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Tools\DynamicIsland.Modules.Tools.csproj" />
    <ProjectReference Include="..\DynamicIsland.Modules.Notifications\DynamicIsland.Modules.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicIsland.Tests" />
  </ItemGroup>

  <!-- Identity-only package and its public certificate for the notification history (D-038). -->
  <ItemGroup>
    <None Include="..\..\packaging\identity\DynamicIslandIdentity.msix" Link="DynamicIslandIdentity.msix" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\packaging\identity\DynamicIslandIdentity.cer" Link="DynamicIslandIdentity.cer" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

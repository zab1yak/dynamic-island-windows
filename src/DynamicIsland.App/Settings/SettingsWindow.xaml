<Window x:Class="DynamicIsland.App.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DynamicIsland.App.Settings"
        xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
        xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI"
        Title="{loc:Tr Settings.Title}" Width="780" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Surface1}"
        Icon="pack://application:,,,/Assets/island.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- General. -->
        <DataTemplate DataType="{x:Type s:GeneralSettingsViewModel}">
            <StackPanel>
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <StackPanel>
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Autostart}" Style="{DynamicResource Settings.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding LaunchAtStartup}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.Autostart}" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Language}" Style="{DynamicResource Settings.Label}" />
                            <ComboBox DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Language}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Tr Settings.Language}" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <StackPanel>
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.HideFullscreen}" Style="{DynamicResource Settings.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.HideFullscreen}" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Recording}" Style="{DynamicResource Settings.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding DetectScreenRecording}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.Recording}" />
                        </DockPanel>
                        <TextBlock Text="{loc:Tr Settings.RecordingHint}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.CheckUpdates}" Style="{DynamicResource Settings.Label}" />
                            <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Tr Settings.CheckUpdates}" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>
            </StackPanel>
        </DataTemplate>

        <!-- Island. -->
        <DataTemplate DataType="{x:Type s:IslandSettingsPage}">
            <StackPanel DataContext="{Binding Settings}">
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <StackPanel>
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Monitor}" Style="{DynamicResource Settings.Label}" />
                            <ComboBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding Monitor}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Tr Settings.Monitor}" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Size}" Style="{DynamicResource Settings.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding IslandScalePercent}" Minimum="70" Maximum="130" Step="5" Suffix="%" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <StackPanel>
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.ExpandDelay}" Style="{DynamicResource Settings.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding ExpandDelayMs}" Minimum="0" Maximum="2000" Step="50" Suffix="{loc:Tr Settings.Ms}" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.CollapseDelay}" Style="{DynamicResource Settings.Label}" />
                            <c:NumberStepper DockPanel.Dock="Right" Value="{Binding CollapseDelayMs}" Minimum="100" Maximum="5000" Step="50" Suffix="{loc:Tr Settings.Ms}" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Hotkey}" Style="{DynamicResource Settings.Label}" />
                            <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="200" Style="{DynamicResource TextField}" IsReadOnly="True"
                                     Text="{Binding Hotkey, Mode=OneWay}" Tag="{loc:Tr Settings.HotkeyPress}" VerticalAlignment="Center"
                                     AutomationProperties.Name="{loc:Tr Settings.Hotkey}" PreviewKeyDown="OnHotkeyKeyDown" />
                        </DockPanel>
                        <TextBlock Text="{Binding HotkeyError}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Orange}"
                                   Visibility="{Binding HotkeyError, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8" />
                    </StackPanel>
                </c:SquircleBorder>
            </StackPanel>
        </DataTemplate>

        <!-- Modules. -->
        <DataTemplate DataType="{x:Type s:ModulesSettingsViewModel}">
            <StackPanel>
                <TextBlock Text="{loc:Tr Settings.ModulesHint}" Style="{DynamicResource Settings.Header}" />
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:ModuleRow}">
                                <DockPanel Style="{DynamicResource Settings.Row}">
                                    <c:Icon Glyph="{Binding Icon}" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Settings.Label}" />
                                    <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Title}" />
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Tr Settings.MoveDown}">
                                        <c:Icon Glyph="ChevronRight" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                            <c:Icon.RenderTransform><RotateTransform Angle="90" /></c:Icon.RenderTransform>
                                        </c:Icon>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Tr Settings.MoveUp}">
                                        <c:Icon Glyph="ChevronLeft" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                            <c:Icon.RenderTransform><RotateTransform Angle="90" /></c:Icon.RenderTransform>
                                        </c:Icon>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:SquircleBorder>
            </StackPanel>
        </DataTemplate>

        <!-- About. -->
        <DataTemplate DataType="{x:Type s:AboutViewModel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Assets/island.ico" Width="48" Height="48" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Dynamic Island for Windows" Style="{DynamicResource Text.Title}" />
                        <TextBlock Style="{DynamicResource Text.Secondary}">
                            <Run Text="{loc:Tr Settings.Version}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                    <StackPanel>
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{Binding UpdateStatus}" Style="{DynamicResource Settings.Label}" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="{loc:Tr Settings.CheckNow}" Command="{Binding CheckForUpdatesCommand}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="GitHub — zab1yak/dynamic-island-windows" Style="{DynamicResource Settings.Label}" />
                            <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="{loc:Tr Settings.Open}" Command="{Binding OpenRepositoryCommand}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Settings.Separator}" />
                        <DockPanel Style="{DynamicResource Settings.Row}">
                            <TextBlock Text="{loc:Tr Settings.Licenses}" Style="{DynamicResource Settings.Label}" />
                            <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="{loc:Tr Settings.Open}" Command="{Binding OpenNoticesCommand}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </c:SquircleBorder>
                <TextBlock Text="{loc:Tr Settings.IconsCredit}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar. -->
        <Border Background="{DynamicResource Island.Background}">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Margin="10,14">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Margin="0,1">
                                        <c:SquircleBorder x:Name="Bg" CornerRadius="8" />
                                        <ContentPresenter Margin="10,7" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type s:SettingsSection}">
                        <StackPanel Orientation="Horizontal">
                            <c:SquircleBorder Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.Surface3}">
                                <c:Icon Glyph="{Binding Icon}" Width="14" Height="14" />
                            </c:SquircleBorder>
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Base}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Content. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Title}" Style="{DynamicResource Text.Title}" FontSize="20" Margin="4,0,0,14" />
                <ContentPresenter Content="{Binding Selected.Content}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

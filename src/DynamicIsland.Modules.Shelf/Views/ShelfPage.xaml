<UserControl x:Class="DynamicIsland.Modules.Shelf.Views.ShelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:DynamicIsland.Modules.Shelf"
             xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
             xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">
    <Grid>
        <!-- Dashed drop zone. -->
        <Rectangle x:Name="Zone" Margin="0,0,0,4" RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="5 4"
                   Stroke="{DynamicResource Brush.Surface3}" Fill="Transparent" />

        <!-- Empty state. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <c:Icon Glyph="Upload" Width="22" Height="22" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="{loc:Tr Shelf.DropHere}" Style="{DynamicResource Text.Title}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,2" />
            <TextBlock Text="{loc:Tr Shelf.DropHint}" Style="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" />
            <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Shelf.PasteShort}" Command="{Binding PasteCommand}"
                    AutomationProperties.Name="{loc:Tr Shelf.Paste}" HorizontalAlignment="Center" Margin="0,8,0,0" Height="26" />
        </StackPanel>

        <!-- Items. -->
        <Grid Margin="10,6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False" Focusable="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <c:SquircleBorder x:Name="Bg" CornerRadius="12" Background="Transparent" />
                                        <ContentPresenter Margin="6" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type s:ShelfItemViewModel}">
                        <StackPanel Width="72" ToolTip="{Binding Path}">
                            <c:SquircleBorder Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center" Background="{DynamicResource Brush.Surface1}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </c:SquircleBorder>
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="70" />
                            <TextBlock Text="{Binding Details}" Style="{DynamicResource Text.Secondary}" FontSize="10" HorizontalAlignment="Center" MaxWidth="70" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Style="{DynamicResource IconButton}" Command="{Binding PasteCommand}" AutomationProperties.Name="{loc:Tr Shelf.Paste}" ToolTip="{loc:Tr Shelf.Paste}">
                    <c:Icon Glyph="ClipboardList" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Button>
                <Button Style="{DynamicResource IconButton}" Command="{Binding ClearAllCommand}" AutomationProperties.Name="{loc:Tr Shelf.ClearAll}" ToolTip="{loc:Tr Shelf.ClearAll}" Margin="0,4,0,0">
                    <c:Icon Glyph="Trash" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Notice}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Orange}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                   Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}" />
    </Grid>
</UserControl>

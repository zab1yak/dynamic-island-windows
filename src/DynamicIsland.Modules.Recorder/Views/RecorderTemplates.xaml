<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:r="clr-namespace:DynamicIsland.Modules.Recorder"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
                    xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">

    <!-- Expanded page: waveform + timer + controls on the left, recent recordings on the right. -->
    <DataTemplate DataType="{x:Type r:RecorderViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <c:VisualizerBars Levels="{Binding Levels}" Height="34" Width="210" BarWidth="4" HorizontalAlignment="Left"
                                  BarBrush="{DynamicResource Brush.Red}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Red}" VerticalAlignment="Center" Margin="0,0,6,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <c:RollingText Text="{Binding ElapsedText}" TextStyle="{DynamicResource Text.Title}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{DynamicResource PrimaryButton.Red}" Width="40" Height="40" Command="{Binding RecordCommand}"
                            AutomationProperties.Name="{loc:Tr Recorder.Record}" ToolTip="{loc:Tr Recorder.Record}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <c:Icon Glyph="Mic" Width="18" Height="18" Foreground="{DynamicResource Brush.OnAccent}" />
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Command="{Binding PauseResumeCommand}"
                            AutomationProperties.Name="{loc:Tr Recorder.Pause}" ToolTip="{loc:Tr Recorder.Pause}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <c:Icon Glyph="Pause" Filled="True" Width="16" Height="16" />
                    </Button>
                    <Button Style="{DynamicResource PrimaryButton.Red}" Width="40" Height="40" Margin="6,0,0,0" Command="{Binding StopCommand}"
                            AutomationProperties.Name="{loc:Tr Recorder.Stop}" ToolTip="{loc:Tr Recorder.Stop}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <c:Icon Glyph="Stop" Filled="True" Width="14" Height="14" Foreground="{DynamicResource Brush.OnAccent}" />
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}"
                            AutomationProperties.Name="{loc:Tr Recorder.OpenFolder}" ToolTip="{loc:Tr Recorder.OpenFolder}">
                        <c:Icon Glyph="FolderOpen" Width="15" Height="15" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Notice}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Orange}"
                           TextWrapping="Wrap" Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="{loc:Tr Recorder.Empty}" Style="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <ListBox ItemsSource="{Binding Recordings}" Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <c:SquircleBorder x:Name="Bg" CornerRadius="8" />
                                            <ContentPresenter Margin="4,1" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type r:RecordingItem}">
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{DynamicResource IconButton}" Width="24" Height="24"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{loc:Tr Recorder.Play}">
                                    <Grid>
                                        <c:Icon Glyph="Play" Filled="True" Width="11" Height="11"
                                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        <c:Icon Glyph="Stop" Filled="True" Width="10" Height="10"
                                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" Margin="4,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Details}" Style="{DynamicResource Text.Secondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Style="{DynamicResource IconButton}" Width="24" Height="24"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Tr Recorder.Delete}">
                                        <c:Icon Glyph="Trash" Width="11" Height="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Live pill while recording: red dot, timer, small waveform. -->
    <DataTemplate DataType="{x:Type r:RecorderLiveViewModel}">
        <Grid Height="34">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Red}" Margin="2,0,8,0" />
                <c:RollingText Text="{Binding Recorder.ElapsedText}" TextStyle="{DynamicResource Island.CompactTime}" />
            </StackPanel>
            <c:VisualizerBars Levels="{Binding Recorder.Levels}" Width="44" Height="14" BarWidth="2" HorizontalAlignment="Right"
                              VerticalAlignment="Center" BarBrush="{DynamicResource Brush.Red}" />
        </Grid>
    </DataTemplate>
    <!-- Settings section: recordings folder and format. -->
    <DataTemplate DataType="{x:Type r:RecorderSettingsViewModel}">
        <c:SquircleBorder Style="{DynamicResource Settings.Group}">
            <StackPanel>
                <DockPanel Style="{DynamicResource Settings.Row}">
                    <TextBlock Text="{loc:Tr Recorder.SaveMp3}" Style="{DynamicResource Settings.Label}" />
                    <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding SaveAsMp3}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{loc:Tr Recorder.SaveMp3}" />
                </DockPanel>
                <Rectangle Style="{DynamicResource Settings.Separator}" />
                <DockPanel Style="{DynamicResource Settings.Row}">
                    <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left" MaxWidth="300">
                        <TextBlock Text="{loc:Tr Recorder.FolderSetting}" Style="{DynamicResource Text.Base}" />
                        <TextBlock Text="{Binding Folder}" Style="{DynamicResource Text.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Content="{loc:Tr Recorder.ChooseFolder}" Command="{Binding ChooseFolderCommand}"
                            VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr Recorder.ChooseFolder}" />
                    <Button DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Background="Transparent" Content="{loc:Tr Recorder.DefaultFolder}"
                            Command="{Binding ResetFolderCommand}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="{loc:Tr Recorder.DefaultFolder}" />
                </DockPanel>
                <TextBlock Text="{Binding FolderError}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Orange}" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="{Binding FolderError, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </c:SquircleBorder>
    </DataTemplate>
</ResourceDictionary>

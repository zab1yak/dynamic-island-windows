<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:DynamicIsland.Modules.Tools"
                    xmlns:v="clr-namespace:DynamicIsland.Modules.Tools.Views"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
                    xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">
    <!-- Shortcuts, the island's FPS and CPU load (green → yellow → red). -->
    <DataTemplate DataType="{x:Type t:ToolsViewModel}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <Button Style="{DynamicResource PillButton}" Height="30" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{loc:Tr Tools.Settings}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="Settings" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Tr Tools.Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource PillButton}" Height="30" Margin="0,8,0,0" Command="{Binding OpenDataFolderCommand}"
                        AutomationProperties.Name="{loc:Tr Tools.Folder}" ToolTip="{loc:Tr Tools.Folder}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Tr Tools.FolderShort}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Column="1" Margin="24,0,8,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:Icon Glyph="Gauge" Width="16" Height="16" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{loc:Tr Tools.Fps}" Style="{DynamicResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding FpsText}" Style="{DynamicResource Text.Title}" FontSize="14" VerticalAlignment="Center" />

                <c:Icon Grid.Row="1" Glyph="Cpu" Width="16" Height="16" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,16,0,0" VerticalAlignment="Center" />
                <v:LoadBar Grid.Row="1" Grid.Column="1" Percent="{Binding CpuPercent}" BrushKey="{Binding CpuBrushKey}" Height="8" Margin="8,16,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CpuText}" Style="{DynamicResource Text.Title}" FontSize="14" Margin="0,16,0,0" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>

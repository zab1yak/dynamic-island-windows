<UserControl x:Class="DynamicIsland.Modules.Translator.Views.TranslatorSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
             xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisible" /></UserControl.Resources>
    <StackPanel>
        <c:SquircleBorder Style="{DynamicResource Settings.Group}">
            <StackPanel Margin="16">
                <TextBlock Text="{loc:Tr Translator.Packages}" Style="{DynamicResource Settings.Label}" />
                <TextBlock Text="{loc:Tr Translator.OfflinePrivacy}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,12" />
                <ItemsControl ItemsSource="{Binding Packages.Packages}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Settings.Label}" />
                                <TextBlock Text="{Binding Details}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" />
                                <TextBlock Text="{Binding State}" Style="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Download}" Command="{Binding DataContext.Packages.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5" />
                                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Remove}" Command="{Binding DataContext.Packages.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5" Margin="5,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Packages.Status}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                <StackPanel Visibility="{Binding Packages.IsBusy, Converter={StaticResource BoolVisible}}" Margin="0,8,0,0">
                    <ProgressBar Value="{Binding Packages.Progress}" Maximum="100" Height="4" />
                    <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Cancel}" Command="{Binding Packages.CancelCommand}" HorizontalAlignment="Left" Padding="10,5" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>
        </c:SquircleBorder>
        <c:SquircleBorder Style="{DynamicResource Settings.Group}" Margin="0,12,0,0">
            <StackPanel Margin="16">
                <CheckBox IsChecked="{Binding Translator.SaveHistory}" Content="{loc:Tr Translator.SaveHistory}" />
                <TextBlock Text="{loc:Tr Translator.HistoryPrivacy}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,8" />
                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.History}" HorizontalAlignment="Left" Padding="10,5" Click="OnHistory" />
            </StackPanel>
        </c:SquircleBorder>
    </StackPanel>
</UserControl>

<Window x:Class="DynamicIsland.Modules.Translator.Views.TranslationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI"
        Title="{loc:Tr Translator.History}" Width="680" Height="480" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface1}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Text}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisible" /></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <CheckBox IsChecked="{Binding SaveHistory}" Content="{loc:Tr Translator.SaveHistory}" />
            <TextBlock Text="{loc:Tr Translator.HistoryPrivacy}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBlock Text="{loc:Tr Translator.EmptyHistory}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Style="{DynamicResource Text.Secondary}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SourceLanguage}" Margin="6,0" /><TextBlock Text="→" /><TextBlock Text="{Binding TargetLanguage}" Margin="6,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Input}" FontSize="14" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Output}" FontSize="14" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" Margin="0,6,0,8" />
                            <WrapPanel>
                                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Restore}" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" Click="OnRestore" />
                                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Copy}" Tag="{Binding Output}" Click="OnCopy" Padding="10,5" Margin="5,0,0,0" />
                                <Button Style="{DynamicResource PillButton}" Content="{loc:Tr Translator.Remove}" Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" Margin="5,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Command="{Binding ClearHistoryCommand}" Padding="12,6" HorizontalAlignment="Right">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PillButton}"><Setter Property="Content" Value="{loc:Tr Translator.ClearHistory}" /><Style.Triggers><DataTrigger Binding="{Binding ConfirmClearHistory}" Value="True"><Setter Property="Content" Value="{loc:Tr Translator.ConfirmClearHistory}" /></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <TextBlock Text="{Binding Status}" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>

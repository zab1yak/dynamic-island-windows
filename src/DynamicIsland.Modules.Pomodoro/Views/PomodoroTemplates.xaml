<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DynamicIsland.Modules.Pomodoro.ViewModels"
                    xmlns:s="clr-namespace:DynamicIsland.Modules.Pomodoro.Services"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
                    xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">

    <!-- Expanded page (reference photo): red ring with a stopwatch on the left; on the right the big
         countdown with the phase and reset, and a row of Short Break · red play · Focus Time below. -->
    <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="70" Height="70" VerticalAlignment="Center">
                <c:RingProgress Value="{Binding Progress}" Thickness="8" ProgressBrush="{DynamicResource Brush.Red}" />
                <c:Icon Glyph="Timer" Width="30" Height="30" Foreground="{DynamicResource Brush.TextPrimary}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <c:RollingText Text="{Binding RemainingText}" TextStyle="{DynamicResource Text.LargeNumber}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Text.Secondary}" HorizontalAlignment="Center">
                            <Run Text="{Binding PhaseText, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource Brush.TextTertiary}" /><Run
                                 Text="{loc:Tr Pomodoro.Today}" Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text=" " /><Run
                                 Text="{Binding CompletedToday, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Margin="0,4,-40,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding ResetCommand}" AutomationProperties.Name="{loc:Tr Pomodoro.Reset}" ToolTip="{loc:Tr Pomodoro.Reset}">
                        <c:Icon Glyph="Reset" Width="15" Height="15" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                    <Button Style="{DynamicResource PillButton}" Height="27" Command="{Binding SelectPhaseCommand}" CommandParameter="{x:Static s:PomodoroPhase.ShortBreak}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="Coffee" Width="13" Height="13" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr Pomodoro.ShortBreak}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource PillButton}" Height="27" Background="{DynamicResource Brush.Red}" Width="56" Margin="8,0"
                            Command="{Binding StartPauseCommand}" AutomationProperties.Name="{loc:Tr Pomodoro.StartPause}">
                        <Grid>
                            <c:Icon x:Name="PlayGlyph" Glyph="Play" Filled="True" Width="15" Height="15" />
                            <c:Icon x:Name="PauseGlyph" Glyph="Pause" Filled="True" Width="15" Height="15" Opacity="0" />
                        </Grid>
                    </Button>
                    <Button Style="{DynamicResource PillButton}" Height="27" Command="{Binding SelectPhaseCommand}" CommandParameter="{x:Static s:PomodoroPhase.Focus}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="Target" Width="13" Height="13" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr Pomodoro.FocusTime}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="PauseGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PauseGlyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="PlayGlyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Live pill: mini ring and countdown. -->
    <DataTemplate DataType="{x:Type vm:PomodoroLiveViewModel}">
        <StackPanel Orientation="Horizontal" Height="34">
            <c:RingProgress Width="18" Height="18" Thickness="3" Value="{Binding Timer.Progress}" ProgressBrush="{DynamicResource Brush.Red}"
                            VerticalAlignment="Center" />
            <c:RollingText Text="{Binding Timer.RemainingText}" TextStyle="{DynamicResource Island.CompactTime}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Timer.PhaseText}" Style="{DynamicResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <!-- Settings section. -->
    <DataTemplate DataType="{x:Type vm:PomodoroSettingsViewModel}">
        <StackPanel>
            <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                <StackPanel>
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Pomodoro.FocusTime}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding FocusMinutes}" Minimum="1" Maximum="180" Step="5" Suffix="{loc:Tr Pomodoro.Min}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Pomodoro.ShortBreak}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding ShortBreakMinutes}" Minimum="1" Maximum="60" Suffix="{loc:Tr Pomodoro.Min}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Pomodoro.LongBreak}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding LongBreakMinutes}" Minimum="1" Maximum="120" Step="5" Suffix="{loc:Tr Pomodoro.Min}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Pomodoro.LongBreakEvery}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding LongBreakEvery}" Minimum="2" Maximum="12" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Pomodoro.SoundSetting}" Style="{DynamicResource Settings.Label}" />
                        <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding Sound}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </c:SquircleBorder>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>

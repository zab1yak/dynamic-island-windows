<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="clr-namespace:DynamicIsland.Modules.Water"
                    xmlns:c="clr-namespace:DynamicIsland.UI.Controls;assembly=DynamicIsland.UI"
                    xmlns:loc="clr-namespace:DynamicIsland.UI.Localization;assembly=DynamicIsland.UI">

    <!-- Expanded page (reference photo): litres with the reminder switch, status, thin bar, then
         − portion + · Drink · Settings · undo; on the right a percent ring with a droplet. -->
    <DataTemplate DataType="{x:Type w:WaterViewModel}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <c:RollingText Text="{Binding TotalText}" TextStyle="{DynamicResource Text.MediumNumber}" VerticalAlignment="Center" />
                    <ToggleButton Style="{DynamicResource ToggleSwitch}" Margin="12,0,0,0" IsChecked="{Binding RemindersEnabled, Mode=OneWay}"
                                  Command="{Binding ToggleRemindersCommand}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{loc:Tr Water.Reminders}" ToolTip="{Binding ReminderText}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,1,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GoalReached}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Style="{DynamicResource ProgressBar.Pill}" Margin="0,6,0,0" Height="4" Width="210" HorizontalAlignment="Left"
                             Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <!-- Portion picker: − 250 ml + (step from the settings, 50–1000 ml). -->
                    <c:SquircleBorder CornerRadius="999" Background="{DynamicResource Brush.Surface2}" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Command="{Binding DecreaseCommand}"
                                    IsEnabled="{Binding CanDecreasePortion}" AutomationProperties.Name="{loc:Tr Water.Less}" ToolTip="{Binding FineStepText}">
                                <c:Icon Glyph="Minus" Width="12" Height="12" />
                            </Button>
                            <c:RollingText Text="{Binding PortionText}" TextStyle="{DynamicResource Text.Base}" MinWidth="52" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Command="{Binding IncreaseCommand}"
                                    IsEnabled="{Binding CanIncreasePortion}" AutomationProperties.Name="{loc:Tr Water.More}" ToolTip="{Binding FineStepText}">
                                <c:Icon Glyph="Plus" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </c:SquircleBorder>
                    <Button Style="{DynamicResource PillButton}" Background="{DynamicResource Brush.Blue}" Foreground="{DynamicResource Brush.OnAccent}" Height="28" Padding="12,0" Margin="8,0,0,0"
                            Command="{Binding DrinkCommand}" AutomationProperties.Name="{Binding DrinkText}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="Droplet" Width="13" Height="13" Margin="0,0,5,0" Foreground="{DynamicResource Brush.OnAccent}" />
                            <TextBlock Text="{Binding DrinkText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource PillButton}" Height="28" Padding="10,0" Margin="6,0,0,0" Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="{loc:Tr Water.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="SlidersHorizontal" Width="13" Height="13" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Tr Water.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Margin="4,0,0,0" Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}" AutomationProperties.Name="{loc:Tr Water.Undo}" ToolTip="{loc:Tr Water.Undo}">
                        <c:Icon Glyph="Undo" Width="14" Height="14" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Margin="14,6" Fill="{DynamicResource Brush.Surface3}" />

            <Grid Grid.Column="2" Width="76" Height="76" VerticalAlignment="Center">
                <c:RingProgress Value="{Binding Progress}" Thickness="6" ProgressBrush="{DynamicResource Brush.Blue}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PercentNumber}" Style="{DynamicResource Text.Title}" FontSize="22" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-3,0,0">
                        <c:Icon Glyph="Droplet" Width="10" Height="10" Foreground="{DynamicResource Brush.Blue}" />
                        <TextBlock Text="%" Style="{DynamicResource Text.Secondary}" FontSize="10" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Live pill: reminder. -->
    <DataTemplate DataType="{x:Type w:WaterLiveViewModel}">
        <StackPanel Orientation="Horizontal" Height="34">
            <c:Icon Glyph="Droplet" Width="16" Height="16" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr Water.ReminderTitle}" Style="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.TextPrimary}"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Water.PercentText}" Style="{DynamicResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <!-- Settings section. -->
    <DataTemplate DataType="{x:Type w:WaterSettingsViewModel}">
        <StackPanel>
            <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                <StackPanel>
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.Goal}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding GoalMl}" Minimum="250" Maximum="10000" Step="250" Suffix="{loc:Tr Water.Ml}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.Portion}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding StepMl}" Minimum="50" Maximum="1000" Step="50" Suffix="{loc:Tr Water.Ml}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.FineStepSetting}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding FineStepMl}" Minimum="10" Maximum="500" Step="10" Suffix="{loc:Tr Water.Ml}" />
                    </DockPanel>
                </StackPanel>
            </c:SquircleBorder>
            <c:SquircleBorder Style="{DynamicResource Settings.Group}">
                <StackPanel>
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.Reminders}" Style="{DynamicResource Settings.Label}" />
                        <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding RemindersEnabled}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.Interval}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding IntervalMinutes}" Minimum="15" Maximum="480" Step="15" Suffix="{loc:Tr Water.Min}" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.ActiveFrom}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding ActiveFromHour}" Minimum="0" Maximum="23" Suffix=":00" />
                    </DockPanel>
                    <Rectangle Style="{DynamicResource Settings.Separator}" />
                    <DockPanel Style="{DynamicResource Settings.Row}">
                        <TextBlock Text="{loc:Tr Water.ActiveTo}" Style="{DynamicResource Settings.Label}" />
                        <c:NumberStepper DockPanel.Dock="Right" Value="{Binding ActiveToHour}" Minimum="1" Maximum="24" Suffix=":00" />
                    </DockPanel>
                </StackPanel>
            </c:SquircleBorder>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
